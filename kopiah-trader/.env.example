# ===== Untuk komputer kamu: salin file ini jadi ".env" lalu isi nilainya =====
# (file .env tidak ikut ke GitHub, aman)
# Hanya dua ini yang boleh berawalan VITE_ (memang publik; keamanannya lewat aturan RLS di Supabase).
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# ===== Key rahasia: JANGAN pakai awalan VITE_ (supaya tidak terkirim ke browser) =====
# Di komputer: isi di .env ini (dipakai saat `npm run dev` untuk Market dan News).
# Di Vercel: isi di Settings > Environment Variables.
TWELVE_DATA_API_KEY=YOUR_API_KEY
# Hanya untuk Vercel:
# GEMINI_API_KEY=YOUR_GEMINI_KEY
# GEMINI_MODEL=gemini-3.8-flash
