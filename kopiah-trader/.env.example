# ===== Untuk komputer kamu: salin file ini jadi ".env" lalu isi nilainya =====
# (file .env tidak ikut ke GitHub, aman)
VITE_TWELVE_DATA_API_KEY=YOUR_API_KEY
VITE_FMP_API_KEY=YOUR_FMP_API_KEY
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# ===== Untuk Vercel saja (Settings > Environment Variables) =====
# JANGAN pakai awalan VITE_ supaya tidak terkirim ke browser.
# GEMINI_API_KEY=YOUR_GEMINI_KEY
# GEMINI_MODEL=gemini-2.5-flash
